#i2c_lcd

from time import sleep_us, sleep

class I2cLcd:
    def __init__(self, i2c, addr, rows, cols):
        self.i2c = i2c
        self.addr = addr
        self.rows = rows
        self.cols = cols

        self.backlight = 0x08

        sleep(0.05)
        self.init_lcd()

    def write(self, data):
        self.i2c.writeto(self.addr, bytearray([data | self.backlight]))

    def pulse(self, data):
        self.write(data | 0x04)
        sleep_us(1)
        self.write(data & ~0x04)
        sleep_us(50)

    def write4bits(self, data):
        self.write(data)
        self.pulse(data)

    def cmd(self, cmd):
        high = cmd & 0xF0
        low = (cmd << 4) & 0xF0

        self.write4bits(high)
        self.write4bits(low)

    def data(self, char):
        high = (ord(char) & 0xF0) | 0x01
        low = ((ord(char) << 4) & 0xF0) | 0x01

        self.write4bits(high)
        self.write4bits(low)

    def init_lcd(self):
        sleep(0.05)
        self.cmd(0x33)
        self.cmd(0x32)
        self.cmd(0x28)
        self.cmd(0x0C)
        self.cmd(0x06)
        self.clear()

    def clear(self):
        self.cmd(0x01)
        sleep(0.002)

    def putstr(self, string):
        for char in string:
            if char == '\n':
                self.cmd(0xC0)
            else:
                self.data(char)
